{
  "name": "@nn-lang/nn",
  "version": "0.1.4",
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "SieR-VR",
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "yarn workspace @nn-lang/nn-test test",
    "build": "yarn workspaces foreach --all --parallel run build",
    "clean": "yarn workspaces foreach --all --parallel run clean",
    "treesitter": "yarn workspace nn-tree-sitter run tree-sitter",
    "format": "yarn oxfmt \"**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx}\" --ignore-path .oxfmtignore --no-error-on-unmatched-pattern",
    "format:check": "yarn oxfmt \"**/*.{js,cjs,mjs,ts,cts,mts,jsx,tsx}\" --ignore-path .oxfmtignore --check --no-error-on-unmatched-pattern",
    "lint": "yarn lint:ox",
    "lint:fix": "yarn lint:ox:fix",
    "lint:ox": "yarn oxlint .",
    "lint:ox:fix": "yarn oxlint . --fix",
    "nn-cli": "node packages/nn-cli/bin/run.js",
    "publish": "yarn workspaces foreach -Apit --no-private npm publish --tolerate-republish",
    "bump:patch": "yarn workspaces foreach -Apit --no-private version patch"
  },
  "dependencies": {
    "ts-features": "^2.0.0"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.44.1",
    "oxc-transform": "^0.133.0",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "yarn@4.9.2",
  "workspaces": [
    "packages/*"
  ]
}
